# =====================================================
# Environment Variables — Fashion Store
# انسخ هذا الملف إلى .env وضع القيم الحقيقية بداخله.
# لا ترفع ملف .env الحقيقي إلى GitHub أبدًا.
# =====================================================

# من Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# اسم المتجر الافتراضي المستخدم فقط كـ fallback قبل تحميل
# إعدادات المتجر من قاعدة البيانات (store_settings).
VITE_DEFAULT_STORE_NAME="Fashion Store"

# ملاحظة مهمة جدًا:
# SUPABASE_SERVICE_ROLE_KEY لا يوضع هنا إطلاقًا ولا في أي متغير
# يبدأ بـ VITE_ لأن أي متغير بادئته VITE_ يُحزَم (bundled) داخل
# كود الـ Frontend ويصبح مرئيًا لأي زائر للموقع.
